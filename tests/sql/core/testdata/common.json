    "name": "joins and clauses",
    "sql": "SELECT DISTINCT u.id AS user_id, t.name FROM app.users AS u INNER JOIN teams AS t ON u.team_id = t.id WHERE t.active >= 1 ORDER BY t.name ASC, u.id DESC;",
    "tree": "(sql:file (sql:select (sql:distinct) (sql:projection (sql:identifier (sql:name \"u\") (sql:name \"id\")) (sql:name \"user_id\")) (sql:projection (sql:identifier (sql:name \"t\") (sql:name \"name\"))) (sql:table (sql:identifier (sql:name \"app\") (sql:name \"users\")) (sql:name \"u\")) (sql:inner-join (sql:table (sql:identifier (sql:name \"teams\")) (sql:name \"t\")) (sql:comparison (sql:identifier (sql:name \"u\") (sql:name \"team_id\")) (sql:operator \"=\") (sql:identifier (sql:name \"t\") (sql:name \"id\")))) (sql:comparison (sql:identifier (sql:name \"t\") (sql:name \"active\")) (sql:operator \">=\") (sql:number \"1\")) (sql:order (sql:identifier (sql:name \"t\") (sql:name \"name\")) (sql:direction \"ASC\")) (sql:order (sql:identifier (sql:name \"u\") (sql:name \"id\")) (sql:direction \"DESC\"))))",
    "printed": "SELECT DISTINCT u.id AS user_id, t.name FROM app.users AS u INNER JOIN teams AS t ON u.team_id = t.id WHERE t.active >= 1 ORDER BY t.name ASC, u.id DESC",
